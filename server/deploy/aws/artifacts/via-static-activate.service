[Unit]
Description=Validate, activate and roll back the nightly static build
After=network-online.target k3s.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
EnvironmentFile=/etc/via-bootstrap.env
TimeoutStartSec=1h
ExecStart=/opt/via/server/deploy/aws/artifacts/fetch.sh --incoming
